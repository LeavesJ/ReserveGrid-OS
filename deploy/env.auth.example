# rg-auth secrets for docker-compose.auth.yml (PB-14). Copy to .env.auth at
# the repo root on the host, fill from the password manager, never commit it
# (.gitignore's .env.* rule covers it), and chmod 600 it.
#
#   cp deploy/env.auth.example .env.auth && chmod 600 .env.auth
#
# Leave a line out entirely rather than blank: rg-auth reads an absent SMTP
# variable as "email disabled" and a blank one as a broken setting.

# Required. Base64url of the 32-byte Ed25519 license signing seed (R-150). The
# same key Fly ran with, so licenses already issued keep validating.
VELDRA_LICENSE_SIGNING_KEY=TODO_FROM_PASSWORD_MANAGER

VELDRA_AUTH_ADMIN_EMAIL=TODO_OPERATOR_EMAIL

# Outbound email. Omit all five to run without email.
VELDRA_AUTH_SMTP_HOST=TODO
VELDRA_AUTH_SMTP_PORT=587
VELDRA_AUTH_SMTP_USER=TODO
VELDRA_AUTH_SMTP_PASS=TODO_FROM_PASSWORD_MANAGER
VELDRA_AUTH_SMTP_FROM=TODO

# Litestream replication, if the Fly deployment had it configured. With these
# set and ./data/auth/auth.db absent, the container restores the database from
# the replica on first boot, which replaces the Fly data export entirely.
# Omit all four to run without replication.
LITESTREAM_REPLICA_BUCKET=TODO
LITESTREAM_REPLICA_ENDPOINT=TODO
LITESTREAM_ACCESS_KEY_ID=TODO_FROM_PASSWORD_MANAGER
LITESTREAM_SECRET_ACCESS_KEY=TODO_FROM_PASSWORD_MANAGER
